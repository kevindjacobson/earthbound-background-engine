{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "earthbound-background-engine",
  "main": "src/cloudflare/worker.mjs",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./.cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PLAYER_ROOMS",
        "class_name": "PlayerRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PlayerRoom"]
    }
  ],
  "routes": [
    {
      "pattern": "justalilguy.com",
      "custom_domain": true
    },
    {
      "pattern": "www.justalilguy.com",
      "custom_domain": true
    },
    {
      "pattern": "earf.justalilguy.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
